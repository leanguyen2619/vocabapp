# Postgres connection string (Neon or any Postgres-compatible provider).
# Copy this file to .env and fill in real values — .env is gitignored.

# Pooled connection (PgBouncer) — used by the running app for all normal queries.
# On Neon, this is the connection string with "-pooler" in the hostname.
DATABASE_URL=

# Unpooled/direct connection — used only by the Prisma CLI (migrate/generate/studio).
# On Neon, this is the same connection string without "-pooler".
DIRECT_URL=

# Sentry project DSN (Settings → Projects → <project> → Client Keys). Safe to leave unset —
# error/performance monitoring is simply skipped without it.
NEXT_PUBLIC_SENTRY_DSN=
