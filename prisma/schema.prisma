// Prisma schema — mirrors src/types/index.ts 1:1 (see that file's header comment).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  student
  admin
}

enum AccountStatus {
  active
  inactive
}

enum AccountLevelStatus {
  locked
  in_progress
  completed
}

enum PartOfSpeech {
  noun
  verb
  adjective
  adverb
  preposition
  pronoun
  conjunction
  interjection
}

enum WordRelationType {
  synonym
  antonym
  related
}

enum PasswordResetRequestStatus {
  pending
  resolved
}

enum PracticeTypeCode {
  multiple_choice
  flashcard
  typing
  listening
  matching
  pos_classification
  sentence_writing
  synonym_antonym
  fill_blank
  word_formation
  listening_comprehension
  reading_comprehension
  word_transformation
  reading_practice
}

enum QuestionStatus {
  pending
  approved
  rejected
}

enum AnswerStatus {
  active
  disabled
}

enum LearningStatus {
  new
  learning
  mastered
}

enum AssignmentStatus {
  pending
  in_progress
  done
  overdue
}

enum WritingSubmissionStatus {
  pending
  graded
}

// ---------- Accounts ----------

model Account {
  id_login     String        @id
  fullName     String
  role         Role
  status       AccountStatus @default(active)
  classId      String?
  avatarUrl    String?
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())

  // Per-student auto-assignment overrides (admin-set, student-level rather than class-level so
  // students in the same class can be on different topics/paces). Both null means "use the normal
  // behavior" — sequential curriculum order and the class's dailyWordTarget, respectively. See
  // pickTodaysWordIds in src/lib/actions/vocabulary.ts.
  pinnedTopicId           Int?
  dailyWordTargetOverride Int?

  // Set the moment auto-assignment (see deriveLastAssignmentRule/pickTodaysWordIds) finds it can no
  // longer fill a fresh batch from the topic+level of the student's last explicit assignment — i.e.
  // that combination has run out of new words. Non-null means "already flagged, don't notify
  // again"; cleared back to null the next time this student receives a fresh explicit assignment,
  // so a newly-exhausted topic can notify again later. Surfaced to the admin as a badge (see
  // StudentSummary.assignRuleExhausted) and, once an email provider is configured, as an email.
  assignRuleExhaustedAt DateTime?

  class       SchoolClass? @relation(fields: [classId], references: [id])
  pinnedTopic Topic?       @relation(fields: [pinnedTopicId], references: [id], onDelete: SetNull)

  sessions              Session[]
  accountLevels         AccountLevel[]
  learningHistory       LearningHistory[]
  exerciseAttempts      ExerciseAttempt[]
  dailyAssignments      DailyAssignment[]
  dailyWordPicks        DailyWordPick[]
  dailyWarmups          DailyWarmup[]
  passwordResetRequests PasswordResetRequest[]
  writingSubmissions    WritingSubmission[]

  @@index([classId])
  @@index([role])
  @@index([pinnedTopicId])
}

// ---------- Password reset requests (new — self-service "forgot password" without email) ----------
// A student/teacher who forgot their password submits a request here; their teacher (or admin)
// sees it and resets the password through the existing admin/teacher reset-password flow, which
// marks the request resolved.

model PasswordResetRequest {
  id         String                      @id @default(cuid())
  accountId  String
  status     PasswordResetRequestStatus  @default(pending)
  createdAt  DateTime                    @default(now())
  resolvedAt DateTime?

  account Account @relation(fields: [accountId], references: [id_login], onDelete: Cascade)

  @@index([accountId])
}

// ---------- Sessions (new — real auth, not in the original ERD) ----------

model Session {
  id        String   @id @default(cuid())
  accountId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id_login], onDelete: Cascade)

  @@index([accountId])
}

// ---------- Classes ----------

model SchoolClass {
  id              String @id @default(cuid())
  className       String
  dailyWordTarget Int    @default(5)

  accounts Account[]
}

// ---------- Levels ----------

model Level {
  id       String @id
  level    String
  maxScore Int    @default(100)

  // Optional auto-unlock: once a student's mastery % of THIS level reaches this threshold, the
  // next level's AccountLevel is silently promoted to in_progress (visible/practiceable) without
  // any admin action or student-facing notice — see recordForVocab in progress-core.ts. Null
  // (the default) means no auto-unlock; the next level stays admin-gated as before. Deliberately
  // separate from maxScore/"completed" — this level's own status/score/trophy display is
  // unaffected, so a student never sees this level marked "done" before it's truly 100% mastered.
  autoUnlockNextAt Int?

  vocabulary      Vocabulary[]
  practiceTypes   PracticeType[]
  accountLevels   AccountLevel[]
  readingPassages ReadingPassage[]
  readingTexts    ReadingText[]
}

// ---------- Accounts_Level ----------

model AccountLevel {
  accountId        String
  levelId          String
  score            Int                @default(0)
  streak           Int                @default(0)
  lastActivityDate DateTime?
  manualNote       String?
  status           AccountLevelStatus @default(locked)

  account Account @relation(fields: [accountId], references: [id_login], onDelete: Cascade)
  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([accountId, levelId])
}

// ---------- Topics ----------

model Topic {
  id         Int    @id @default(autoincrement())
  topic      String
  definition String

  vocabulary       Vocabulary[]
  pinnedByAccounts Account[]
  readingPassages  ReadingPassage[]
  readingTexts     ReadingText[]
}

// ---------- Vocabulations ----------

model Vocabulary {
  id           String       @id @default(cuid())
  vocab        String
  definition   String
  meanVI       String
  partOfSpeech PartOfSpeech
  ipa          String?
  levelId      String
  topicId      Int

  level Level @relation(fields: [levelId], references: [id])
  topic Topic @relation(fields: [topicId], references: [id])

  mainRelations      WordRelation[]       @relation("MainVocab")
  subRelations       WordRelation[]       @relation("SubVocab")
  questions          Question[]
  learningHistory    LearningHistory[]
  exerciseAttempts   ExerciseAttempt[]
  dailyAssignments   DailyAssignment[]
  dailyWordPicks     DailyWordPick[]
  writingSubmissions WritingSubmission[]

  @@index([levelId])
}

// ---------- Word_Relations ----------

model WordRelation {
  mainId       String
  subId        String
  relationship WordRelationType

  main Vocabulary @relation("MainVocab", fields: [mainId], references: [id], onDelete: Cascade)
  sub  Vocabulary @relation("SubVocab", fields: [subId], references: [id], onDelete: Cascade)

  @@id([mainId, subId])
}

// ---------- PracType ----------
// `name`/`description`/`enabled` fold in what used to be a separate
// localStorage-only settings store (src/lib/exercise-types.ts).

model PracticeType {
  id          String           @id @default(cuid())
  levelId     String
  type        PracticeTypeCode @unique
  definition  String
  name        String
  description String
  enabled     Boolean          @default(true)

  level Level @relation(fields: [levelId], references: [id])

  questions        Question[]
  exerciseAttempts ExerciseAttempt[]
}

// ---------- QuestionBank ----------

model Question {
  id           String         @id @default(cuid())
  vocabId      String
  pracTypeId   String
  questionText String
  explanation  String?
  status       QuestionStatus @default(pending)

  // Only set for reading_comprehension: which passage this question is one numbered blank of,
  // and that blank's 1-based position within it (matches the "___N___" marker in
  // ReadingPassage.body — see that model's comment). Null for every other practice type.
  passageId   String?
  blankNumber Int?

  // Only set for reading_practice: which plain-text passage this is a comprehension question
  // about (see ReadingText's comment). blankNumber is unused here — a comprehension question
  // isn't tied to one numbered gap, just to the passage as a whole.
  readingTextId String?

  vocab       Vocabulary      @relation(fields: [vocabId], references: [id])
  pracType    PracticeType    @relation(fields: [pracTypeId], references: [id])
  passage     ReadingPassage? @relation(fields: [passageId], references: [id])
  readingText ReadingText?    @relation(fields: [readingTextId], references: [id])

  answers          Answer[]
  exerciseAttempts ExerciseAttempt[]

  @@index([pracTypeId, status])
  @@index([vocabId])
  @@index([passageId])
  @@index([readingTextId])
}

// A single reading-comprehension exercise: one short story shared by several vocabulary blanks
// (Cambridge-style gapped passage), rather than the usual one-question-per-word shape every other
// practice type uses. `body` holds the raw story text with literal "___1___", "___2___", ...
// placeholders — the client splits on these to interleave the real paragraph text with each
// blank's multiple-choice options (via the linked Question rows, ordered by blankNumber).
model ReadingPassage {
  id        String         @id @default(cuid())
  title     String
  body      String
  levelId   String
  topicId   Int
  status    QuestionStatus @default(pending)
  createdAt DateTime       @default(now())

  level     Level      @relation(fields: [levelId], references: [id])
  topic     Topic      @relation(fields: [topicId], references: [id])
  questions Question[]

  @@index([levelId, status])
}

// A plain reading passage for reading_practice ("Đọc hiểu") — ordinary prose, no blank markers,
// unlike ReadingPassage above. Several approved passages typically exist per level (a pool); which
// one a given student is shown is picked at read time by scoring word overlap between the
// passage's own text and that student's already-learned vocabulary (see
// getMyReadingTextAction/scorePassageForAccount in practice-content.ts) rather than by a fixed
// order, so words a student already knows are more likely to show up in context. The linked
// Question rows (readingTextId set, blankNumber null) are comprehension-check questions about the
// passage's content, answered after reading — not per-word blanks.
model ReadingText {
  id        String         @id @default(cuid())
  title     String
  body      String
  levelId   String
  topicId   Int
  status    QuestionStatus @default(pending)
  createdAt DateTime       @default(now())

  level     Level      @relation(fields: [levelId], references: [id])
  topic     Topic      @relation(fields: [topicId], references: [id])
  questions Question[]

  @@index([levelId, status])
}

// ---------- AnswersBank ----------
// Composite (questionId, ansId) is the natural/business key the app already
// uses (e.g. `${questionId}_a${i}`); a surrogate `id` is added only so
// ExerciseAttempt can hold a single-column FK to a specific answer.

model Answer {
  id         String       @id @default(cuid())
  questionId String
  ansId      String
  ansText    String
  status     AnswerStatus @default(active)
  isCorrect  Boolean      @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  exerciseAttempts ExerciseAttempt[]

  @@unique([questionId, ansId])
}

// ---------- Exercise_Attempts ----------
// Table exists for schema fidelity; not written to by the app yet (see plan).

model ExerciseAttempt {
  id          String   @id @default(cuid())
  accountId   String
  vocabId     String
  questionId  String
  pracTypeId  String
  answerId    String
  timeSpentMs Int
  attemptedAt DateTime @default(now())
  isCorrect   Boolean

  account  Account      @relation(fields: [accountId], references: [id_login], onDelete: Cascade)
  vocab    Vocabulary   @relation(fields: [vocabId], references: [id])
  question Question     @relation(fields: [questionId], references: [id])
  pracType PracticeType @relation(fields: [pracTypeId], references: [id])
  answer   Answer       @relation(fields: [answerId], references: [id])
}

// ---------- Learning_History ----------

model LearningHistory {
  accountId String
  vocabId   String
  lastDate  DateTime       @default(now())
  status    LearningStatus @default(new)

  account Account    @relation(fields: [accountId], references: [id_login], onDelete: Cascade)
  vocab   Vocabulary @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@id([accountId, vocabId])
}

// ---------- Daily_Assignments ----------
// A teacher's own assignment ledger: rows persist across days until the word is mastered or the
// teacher cancels it (see assignVocabularyToClassAction/cancelAssignmentAction). Not date-scoped
// in practice — assignedDate records when it was assigned, not an expiry. Distinct from
// DailyWordPick below, which pins what a student actually sees as "today's words".

model DailyAssignment {
  assignmentId String           @id @default(cuid())
  accountId    String
  vocabId      String
  assignedDate DateTime
  status       AssignmentStatus @default(pending)

  account Account    @relation(fields: [accountId], references: [id_login], onDelete: Cascade)
  vocab   Vocabulary @relation(fields: [vocabId], references: [id])

  @@unique([accountId, vocabId, assignedDate])
}

// ---------- Daily_Word_Picks (new) ----------
// Pins the exact set of vocab words shown to a student for one calendar day, so "today's words"
// (and its completion count) can't drift mid-day as words move between new/learning/mastered —
// see computeDailyWords in src/lib/actions/vocabulary.ts. Kept separate from DailyAssignment so
// an auto-filled pick never shows up as something a teacher explicitly assigned (and therefore
// something they could "cancel").

model DailyWordPick {
  id         String   @id @default(cuid())
  accountId  String
  vocabId    String
  pickedDate DateTime

  account Account    @relation(fields: [accountId], references: [id_login], onDelete: Cascade)
  vocab   Vocabulary @relation(fields: [vocabId], references: [id], onDelete: Restrict)

  @@unique([accountId, vocabId, pickedDate])
}

// ---------- Daily_Warmups (new) ----------
// Tracks the mandatory "3 random exercises" a student must clear once per calendar day before any
// other student page lets them through (see redirectIfWarmupIncomplete). practiceTypeCodes is picked
// once per day (excluding flashcard, level-gated, verified to actually have content) and pinned
// here so it can't drift mid-day; completedCodes accumulates as each one is finished.

model DailyWarmup {
  id                String             @id @default(cuid())
  accountId         String
  warmupDate        DateTime
  practiceTypeCodes PracticeTypeCode[]
  completedCodes    PracticeTypeCode[]

  account Account @relation(fields: [accountId], references: [id_login], onDelete: Cascade)

  @@unique([accountId, warmupDate])
}

// ---------- Writing_Submissions (new) ----------
// Sentence-writing answers are free-form English text, not multiple-choice — an admin (acting as
// the teacher) reads and scores each one 0-100 by hand rather than the student self-reporting
// "I wrote it correctly" (see gradeWritingSubmissionAction). Grading is what feeds recordForVocab,
// so LearningHistory/AccountLevel progress for this practice type now reflects a real assessment
// instead of self-report. Submitting still completes the exercise/warmup step immediately — the
// student doesn't wait on the admin to move on, only to see their score.

model WritingSubmission {
  id          String                  @id @default(cuid())
  accountId   String
  vocabId     String
  sentence    String
  status      WritingSubmissionStatus @default(pending)
  score       Int?
  feedback    String?
  submittedAt DateTime                @default(now())
  gradedAt    DateTime?
  gradedBy    String?

  account Account    @relation(fields: [accountId], references: [id_login], onDelete: Cascade)
  vocab   Vocabulary @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([status])
}
